# =========================================================================
# .gitignore - TCP Benchmark Research Project
# Quy chuẩn loại bỏ các file biên dịch, rác IDE, cache và dữ liệu tạm
# =========================================================================

# === Java & Build Artifacts ===
target/
bin/
out/
build/
dist/
*.class
*.jar
*.war
*.ear
*.nar
*.log
hs_err_pid*
replay_pid*

# Maven
!.mvn/wrapper/maven-wrapper.jar

# === IDE & Editors ===
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Visual Studio Code
.vscode/

# Eclipse
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# === Python (Data Analysis & Visualization) ===
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/
env/
ENV/
*.egg-info/

# === Operating System Files ===
# macOS
.DS_Store